package Funkcije;
import java.util.Scanner;

public class vjezbanje {
	
	public static int sumaDjelilaca(int n) {
		int suma = 0;
		for (int i = 2; i < n; i++) {
			if (n % i == 0) {
				suma = suma + i;
			}
		}
		return suma;
	}
	
	public static boolean prost(int n) {
		int suma = sumaDjelilaca(n);
		
		if(suma == 0) return true;
		else return false;
	}
	
	// napisati funkciju koja vraca sumu prostih
	// brojeva od 1 do n
	public static int sumaProstih (int n) {
	 int suma = 0;
	 for (int i = 1; i <= n; i++) {
	 if (prost(i)) {
		 suma = suma + i;
	 }
	 }
	
	 return suma;
      }	
	
	public static void main(String[] args) {
        Scanner sc = new Scanner (System.in);
        int n = sc.nextInt();
        System.out.println (sumaProstih(n));
	}
}



        
	
	
		
	
	
























